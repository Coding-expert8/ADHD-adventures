draw_set_color(c_white)
draw_set_alpha(text_alpha)
draw_set_font(fnt_default)
draw_text(50, 50, "HOW TO PLAY")

draw_text(50, 100, "Move: Left and Right arrow Keys")
draw_text(50, 180, "In the bridge minigame:")
draw_text(50, 210, "A question will appear on screen.")
draw_text(50, 240, "Type the LONGEST correct answer you can think of.")
draw_text(50, 270, "Press Enter to submit your answer.")
draw_text(50, 300, "Each letter in your answer spawns one bridge block.")
draw_text(50, 330, "Wrong answers spawn no blocks!")

draw_text(50, 380, "Watch out - some blocks will randomly collapse")
draw_text(50, 410, "after a few rounds. Keep moving!")

draw_text(50, 460, "If you fall with nothing under you, you restart.")

draw_text(room_width/2, 520, "Click anywhere to continue")