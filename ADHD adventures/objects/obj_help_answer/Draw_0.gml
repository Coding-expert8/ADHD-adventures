
draw_set_color(c_white)
draw_set_font(fnt_title)
draw_set_alpha(1)
draw_text(100, 50, "HOW TO PLAY")
draw_set_font(fnt_default)
draw_set_alpha(text)

draw_text(100, 130, "Controls:")
draw_text(140, 170, "- Arrow keys to move")
draw_text(140, 210, "- Hold Shift to run")

draw_text(100, 280, "Bridge Challenge:")
draw_text(140, 320, "- A question appears on screen")
draw_text(140, 360, "- Type the longest correct answer you can think of")
draw_text(140, 400, "- Press Enter to submit")
draw_text(140, 440, "- Correct answers spawn bridge blocks")
draw_text(140, 480, "- Wrong answers spawn nothing")

draw_text(100, 550, "Watch Out:")
draw_text(140, 590, "- Some blocks randomly collapse after a few rounds")
draw_text(140, 630, "- Keep moving so you don't fall")

draw_text(900, 700, "Click anywhere to continue")
