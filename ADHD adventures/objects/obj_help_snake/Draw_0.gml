
draw_set_color(c_white)
draw_set_font(fnt_title)
draw_set_alpha(1)
draw_text(100, 50, "HOW TO PLAY")
draw_set_font(fnt_default)
draw_set_alpha(text1)

draw_text(100, 130, "Controls:")
draw_text(140, 170, "- Arrow keys to move")

draw_text(100, 280, "Goal:")
draw_text(140, 320, "- Eat fruit to grow and score points")
draw_text(140, 360, "- Don't hit the walls or your own tail")

draw_text(100, 430, "Power-Up Fruits:")
draw_text(140, 470, "- Slow: temporarily slows the snake down")
draw_text(140, 510, "- Fast: temporarily speeds the snake up")
draw_text(140, 550, "- Double Score: fruit is worth double for a while")
draw_text(140, 590, "- Shrink: removes a couple of segments")

draw_text(100, 660, "Watch Out:")
draw_text(140, 700, "- Snake can hit itself")
draw_text(140, 730, "- Snake can hit walls")

draw_text(900, 700, "Click anywhere to continue")