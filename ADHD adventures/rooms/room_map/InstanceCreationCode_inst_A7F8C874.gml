// Major NPC: talks, then sends the player into the bridge crossing game.
sprite_index = spr_char_3_idle_down;
speaker      = "Bridget";
dialogue     = [
	"The bridge washed away in the last storm!",
	"I can build a new one, but I need a hand with the planks.",
	"Answer my questions right and we'll have it up in no time!",
];
target_room  = room_answer_help;
