// Example shade region, dropped next to the player spawn so it can be seen
// straight away -- drag it onto the foot of a cliff, or delete it.
//
// Everything here is optional; without it the region uses the defaults in
// scr_light (SHADE_COVER, SHADE_FEATHER, SHADE_COLOUR).
shade_cover   = 0.22;    // 0 = nothing, 0.5 = heavy. "Slightly darker" lives around 0.2
shade_feather = 48;      // pixels the edge fades over. Lower it for a doorway
