// Small NPC at the road from the city into the desert: hints at the boss pad.
sprite_index = spr_npc_5;
speaker      = "Wanderer";
dialogue     = [
	"Heading into the desert? Stay hydrated.",
	"They say something big sleeps under the stone square with the pillars, out west.",
	"Only someone holding all six pills can wake it... if they dare.",
];
